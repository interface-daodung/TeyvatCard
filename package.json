    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-remove-console": "^2.2.0",
    "workbox-window": "^7.4.0"
  },
  "description": "A turn-based card combat game built with Phaser 3 and TypeScript, featuring a rich progression system, modern UI, and multi-language support.",
