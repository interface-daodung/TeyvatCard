# API base URL (game server) – dev: local server để tránh CORS; production build dùng admin.teyvatcard.site
# VITE_API_URL=https://admin.teyvatcard.site
VITE_API_URL=http://localhost:3001

# Google OAuth Client ID (từ Google Cloud Console)
# Thêm cả http://localhost:3000 vào Authorized JavaScript origins
VITE_GOOGLE_CLIENT_ID=65384344250-t8fmkl17h0p1semaq4n8patt6ksrdkse.apps.googleusercontent.com

# Dev mode: true = key plain + JSON (dễ debug), false = key HMAC + value AES
VITE_IS_DEV=true

# Key AES cho localStorage (chỉ dùng khi VITE_IS_DEV=false, làm rối data chứ không bảo mật thật)
VITE_STORAGE_SECRET_KEY=your-secret-key-change-in-production










