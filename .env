# ===========================================
# TeyvatCard – biến dùng chung / placeholder
# File này được load trong mọi mode; điền giá trị thật hoặc dùng override ở .env.development / .env.production
# ===========================================
VITE_APP_NAME=Teyvat Card

VITE_APP_VERSION=1.0.0

# Key AES cho localStorage (chỉ dùng khi VITE_IS_DEV=false – làm rối data, không bảo mật thật)
# Thay bằng key thật khi deploy production.
VITE_STORAGE_SECRET_KEY=your-secret-key-change-in-production

# Google OAuth Client ID (từ Google Cloud Console)
# Thêm http://localhost:3000 (dev) và domain production vào Authorized JavaScript origins
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com


